---
/**
 * Inline SVG icons (no icon font / third-party CDN required).
 * Decorative by default; pass `label` to expose the icon to assistive tech.
 */
export type IconName = 'github' | 'linkedin' | 'x' | 'mail' | 'link' | 'arrow';

interface Props {
  name: IconName;
  label?: string;
  size?: number;
}

const { name, label, size = 20 } = Astro.props;

const paths: Record<IconName, string> = {
