---
import { site } from '@/config/site';
import Icon from '../Icon.astro';
import Link from '../Link.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    {
      site.availableForWork && (
        <p class="hero__status">
          <span class="dot" aria-hidden="true" />
          Open to new opportunities
        </p>
      )
    }
    <h1 id="hero-title">
      <span class="hero__hello">Hi, I'm {site.name}.</span>
      <span class="hero__role">{site.role}</span>
    </h1>
    <p class="hero__tagline">{site.tagline}</p>
    <div class="hero__actions">
      <Link href="/projects" class="button button--primary">
        View projects <Icon name="arrow" size={18} />
      </Link>
      <Link href="/#contact" class="button">Get in touch</Link>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(4rem, 14vw, 8rem) clamp(2rem, 6vw, 3rem);
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.5rem;
    padding: 0.25rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #22c55e;
  }

  h1 {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    font-size: clamp(2.3rem, 7vw, 4rem);
  }

  .hero__role {
    color: var(--muted);
  }

  .hero__tagline {
    max-width: 38rem;
    margin: 1.5rem 0 2rem;
    color: var(--muted);
    font-size: 1.2rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
