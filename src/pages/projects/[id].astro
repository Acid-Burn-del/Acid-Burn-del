---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Icon from '@/components/Icon.astro';
import Link from '@/components/Link.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate } from '@/lib/format';
import { getProjects, type Project } from '@/lib/projects';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, summary, date, tags, repo, demo } = project.data;
const { Content } = await render(project);
---

<BaseLayout title={title} description={summary}>
  <article class="container page">
    <p class="back">
      <Link href="/projects">← All projects</Link>
    </p>
    <header>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
      </p>
      <p class="lead">{summary}</p>
      {
        tags.length > 0 && (
          <ul class="tags" aria-label="Technologies">
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
      {
        (repo || demo) && (
          <p class="links">
            {repo && (
              <Link href={repo} class="button">
                <Icon name="github" size={18} /> Source code
              </Link>
            )}
            {demo && (
              <Link href={demo} class="button button--primary">
                <Icon name="link" size={18} /> Live demo
              </Link>
            )}
          </p>
        )
      }
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(2rem, 6vw, 4rem);
  }

  .back {
    margin: 0 0 2rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 2.75rem);
  }

  .meta {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .lead {
    max-width: 44rem;
    color: var(--muted);
    font-size: 1.15rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  header {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
</style>
